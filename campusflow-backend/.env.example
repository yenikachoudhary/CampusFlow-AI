NODE_ENV=development
PORT=3000
HOST=0.0.0.0
WEB_WORKERS=1

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# MongoDB Atlas (required in production)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=campusflow

# In development, if Atlas is unreachable, the API can start with an in-memory store.
# Production ignores this and always requires MongoDB Atlas.
DEV_ALLOW_MOCK_DATASTORE=true

REDIS_URL=redis://localhost:6379

NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_POLL_MS=5000

HMAC_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=campusflow
JWT_AUDIENCE=campusflow-web

# Development login password used only when seeding demo users
DEV_LOGIN_PASSWORD=campusflow-dev

# OpenAI-compatible provider settings; keep the API key server-side
AI_API_URL=
AI_API_KEY=
AI_MODEL=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
BODY_LIMIT_BYTES=1048576
CACHE_TTL_SECONDS=300
VECTOR_NUM_CANDIDATES=100
VECTOR_LIMIT=5
